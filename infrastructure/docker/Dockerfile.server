# ResearchX Express server — multi-stage production image
FROM node:20-alpine AS build
WORKDIR /repo
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/
COPY packages/contracts/package.json packages/contracts/
COPY packages/config/package.json packages/config/
RUN npm ci --workspace=researchx-server --include-workspace-root \
  || npm install --workspace=researchx-server --include-workspace-root
COPY apps/server apps/server
COPY packages packages
RUN npm run build -w researchx-server \
  && npm prune --omit=dev --workspace=researchx-server --include-workspace-root

FROM node:20-alpine AS runtime
RUN addgroup -S app && adduser -S -G app appuser
WORKDIR /repo
COPY --from=build /repo/package.json /repo/package-lock.json ./
COPY --from=build /repo/apps/server/package.json ./apps/server/
COPY --from=build /repo/apps/server/dist ./apps/server/dist
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/apps/server/node_modules ./apps/server/node_modules
ENV NODE_ENV=production \
    PORT=5000
USER appuser
WORKDIR /repo/apps/server
EXPOSE 5000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||5000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/server.js"]
