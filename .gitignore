# Environment — never commit secrets
.env
.env.local
.env.*.local
.env.example
**/.env.example
*.pem

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
# Python packaging dirs (repo root only — do not ignore apps/*/src/lib)
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
/build/
/dist/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Node
node_modules/
**/dist/
**/coverage/
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo
.cursor/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Data (keep structure, ignore contents)
data/cache/*
data/outputs/*
data/documents/*
data/chroma/*
data/raw/*
data/processed/*
!data/**/.gitkeep

# Evaluation results (keep structure)
evaluation/results/*
!evaluation/results/.gitkeep
!evaluation/results/.gitignore

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
