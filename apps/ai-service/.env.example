# ── LLM Provider ──────────────────────────────────────────
# Options: groq | gemini | mock
# Groq examples: openai/gpt-oss-20b | qwen/qwen3.8-27b
# Gemini examples: gemini-2.5-flash | gemini-flash-latest
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b

# Primary Groq key (required when LLM_PROVIDER=groq)
GROQ_API_KEY=
# Optional backups — used automatically if the primary key is rate-limited (HTTP 429)
GROQ_API_KEY_2=
GROQ_API_KEY_3=

GEMINI_API_KEY=

# ── Search Provider ───────────────────────────────────────
# Options: duckduckgo | tavily | serper
SEARCH_PROVIDER=tavily
SEARCH_FALLBACK=serper

TAVILY_API_KEY=
SERPER_API_KEY=

# ── Pipeline Limits ───────────────────────────────────────
MAX_SOURCES=20
MAX_RESEARCH_ITERATIONS=2
MAX_CONCURRENT_AGENTS=3
MAX_RESEARCH_TIME=300
MAX_CONTENT_LENGTH=50000
REQUEST_TIMEOUT=30

# ── Paths ─────────────────────────────────────────────────
CHROMA_PATH=./data/chroma
CACHE_PATH=./data/cache
OUTPUT_PATH=./data/outputs
DOCUMENTS_PATH=./data/documents

# ── API / FastAPI ─────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
# Comma-separated browser origins. Do not use * unless you intentionally want open CORS.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
APP_VERSION=0.1.0
APP_ENV=development

# ── Mode ──────────────────────────────────────────────────
# Set true to run without external APIs (deterministic fake data)
MOCK_MODE=false

# ── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
