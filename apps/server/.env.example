# ResearchX Express application backend
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/researchx
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FASTAPI_URL=http://127.0.0.1:8000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
NODE_ENV=development
# Absolute or repo-relative path shared with AI service (data/documents)
DOCUMENTS_PATH=../../data/documents
MAX_UPLOAD_BYTES=20971520
MAX_DOCS_PER_PROJECT=20
