# ResearchX — environment template (copy to `.env` — never commit secrets)
# Free-first defaults: mock LLM + DuckDuckGo + local Mongo/Redis via Docker Compose.

# ── Shared ──────────────────────────────────────────────
APP_ENV=development
NODE_ENV=development
MOCK_MODE=true
ALLOW_MOCK_MODE=true
ALLOW_EVALUATION=true

# ── Auth / Express ──────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/researchx
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
FASTAPI_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DOCUMENTS_PATH=./data/documents
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20
RESEARCH_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=40

# Optional Redis (leave empty to disable — app still works)
REDIS_URL=

# ── Frontend (Vite) ─────────────────────────────────────
VITE_API_URL=http://127.0.0.1:5000

# ── AI service / providers ──────────────────────────────
LLM_PROVIDER=mock
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GEMINI_API_KEY=

SEARCH_PROVIDER=duckduckgo
SEARCH_FALLBACK=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=

# Free-tier cost controls
MAX_SOURCES=20
MAX_RESEARCH_ITERATIONS=2
MAX_CONCURRENT_RESEARCH=4
MAX_CONCURRENT_SEARCH=5
MAX_CONCURRENT_LLM_REQUESTS=4
MAX_CONCURRENT_AGENTS=3
MAX_SEARCH_QUERIES=20
MAX_CHUNKS=500
MAX_CONTEXT_SIZE=12000
MAX_LLM_CALLS=40
MAX_PDF_PAGES=200
MAX_DOCUMENT_PAGES=200
MAX_RESEARCH_TIME=300
REQUEST_TIMEOUT=30

CHROMA_PATH=./data/chroma
CACHE_PATH=./data/cache
OUTPUT_PATH=./data/outputs
DOCUMENTS_PATH=./data/documents
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
REDIS_TTL_SECONDS=3600
LOG_LEVEL=INFO
